<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_staging</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Step 1+2: reset H2 + staging (Sheets/Oracle multas/Oracle informes/MySQL) + Hop RPT informes + R UNION multas</description>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/08/11 10:00:00.000</created_date>
  <modified_date>2026/08/13 11:00:00.000</modified_date>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>48</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>@echo off
cd /d "${PROJECT_HOME}"
call h2\scripts\reset_and_create.bat
</script>
      <name>Reset H2 clean</name>
      <description>stop + start H2 mem + DDL (00_reset.sql + 01_schema.sql con tablas STG_*)</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>176</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/workflows/load_sheets.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <create_parent_folder>N</create_parent_folder>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>load_sheets.hwf</name>
      <description>Google Sheets -> H2 (pl_gs1_multas, pl_gs1_etapas, pl_gs2_multas)</description>
      <type>WORKFLOW</type>
      <attributes/>
      <xloc>336</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/pipelines/pl_stage_oracle.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>Pipeline Oracle</name>
      <description>pl_stage_oracle.hpl: SISUD.VW_MULTA_COERCITIVA -> H2 STG_ORA_VW_MULTA_COERCITIVA</description>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>496</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/pipelines/pl_stage_informes.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>Pipeline Informes</name>
      <description>pl_stage_informes.hpl: SISUD.CSEP_INFORMES_VIEW -> H2 STG_ORA_CSEP_INFORMES</description>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/pipelines/pl_stage_mysql.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>Pipeline MySQL</name>
      <description>pl_stage_mysql.hpl: gappsdb.T_MVC_MULTACOERCITIVA_MC -> H2 STG_MYSQL_T_MVC_MULTACOERCITIVA</description>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>816</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connection>oracle_repocsep</connection>
      <sql/>
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/create_ORACLE_RPT_INFORME_SUPERVISION.sql</sqlfilename>
      <sendOneStatement>N</sendOneStatement>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlSingleStatementOnNewConnection>N</sqlSingleStatementOnNewConnection>
      <name>Ensure RPT Informes DDL</name>
      <description>CREATE TABLE/INDEX idempotente RPT_INFORME_SUPERVISION en REPOCSEP</description>
      <type>SQL</type>
      <attributes/>
      <xloc>816</xloc>
      <yloc>320</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/pipelines/pl_rpt_informes.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>Pipeline RPT Informes</name>
      <description>pl_rpt_informes.hpl: H2 STG_ORA_CSEP_INFORMES -> REPOCSEP.RPT_INFORME_SUPERVISION (Hop-only)</description>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>976</xloc>
      <yloc>320</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>@echo off
setlocal enabledelayedexpansion
cd /d "${PROJECT_HOME}"
set "RSCRIPT="
where Rscript >nul 2>&amp;1
if not errorlevel 1 set "RSCRIPT=Rscript"
if not defined RSCRIPT (
  for /d %%D in ("%ProgramFiles%\R\R-*") do (
    if exist "%%D\bin\Rscript.exe" set "RSCRIPT=%%D\bin\Rscript.exe"
  )
)
if not defined RSCRIPT (
  echo ERROR: no se encontro Rscript. Instala R o agregalo al PATH.
  exit /b 1
)
call "!RSCRIPT!" r\main.R 2>&amp;1
exit /b !ERRORLEVEL!
</script>
      <name>Run R</name>
      <description>Rscript r/main.R: STG_* multas -> consolidar_multas (UNION FUENTE) -> REPOCSEP.RPT_MULTA_COERCITIVA</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>976</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <xloc>1136</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Reset H2 clean</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Reset H2 clean</from>
      <to>load_sheets.hwf</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>load_sheets.hwf</from>
      <to>Pipeline Oracle</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pipeline Oracle</from>
      <to>Pipeline Informes</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pipeline Informes</from>
      <to>Pipeline MySQL</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pipeline MySQL</from>
      <to>Ensure RPT Informes DDL</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ensure RPT Informes DDL</from>
      <to>Pipeline RPT Informes</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pipeline RPT Informes</from>
      <to>Run R</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run R</from>
      <to>Success</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>
